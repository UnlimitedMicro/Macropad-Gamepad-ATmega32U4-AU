/*
 * MicroPad V1 - Profile 1: Keyboard & Mouse Macro Controller
 * Target Board: Arduino Leonardo or Arduino Micro
 * Required Libraries: Keyboard.h, Mouse.h (Included with Arduino IDE)
 */

#include <Keyboard.h>
#include <Mouse.h>

// --- Pin Definitions ---
const int PIN_JOY_X  = A0;
const int PIN_JOY_Y  = A1;
const int PIN_JOY_SW = 7;
const int PIN_POT    = A5;
const int PIN_BTN1   = 0;
const int PIN_BTN2   = 1;
const int PIN_BTN3   = 2;
const int PIN_BTN4   = 3;
const int PIN_LED    = 8;

// --- Mouse Configuration ---
const int JOY_CENTER = 512;
const int DEADZONE   = 40;  // Ignore drift around center position
const int MAX_SPEED  = 10;  // Mouse cursor sensitivity

// Button state tracking for clean single-press triggering
bool lastJoyBtn = HIGH;
bool lastBtn1   = HIGH;
bool lastBtn2   = HIGH;
bool lastBtn3   = HIGH;
bool lastBtn4   = HIGH;

void setup() {
  // Configure input pins with internal pull-ups
  pinMode(PIN_JOY_SW, INPUT_PULLUP);
  pinMode(PIN_BTN1,   INPUT_PULLUP);
  pinMode(PIN_BTN2,   INPUT_PULLUP);
  pinMode(PIN_BTN3,   INPUT_PULLUP);
  pinMode(PIN_BTN4,   INPUT_PULLUP);

  // Status LED on
  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, HIGH);

  // Start USB HID
  Keyboard.begin();
  Mouse.begin();
}

void loop() {
  // ----------------------------------------------------
  // 1. ANALOG JOYSTICK -> MOUSE MOVEMENT
  // ----------------------------------------------------
  int xRaw = analogRead(PIN_JOY_X) - JOY_CENTER;
  int yRaw = analogRead(PIN_JOY_Y) - JOY_CENTER;

  int moveX = 0;
  int moveY = 0;

  if (abs(xRaw) > DEADZONE) {
    moveX = map(xRaw, -512, 512, -MAX_SPEED, MAX_SPEED);
  }
  if (abs(yRaw) > DEADZONE) {
    // Invert Y axis for standard screen coordinates
    moveY = map(yRaw, -512, 512, MAX_SPEED, -MAX_SPEED);
  }

  if (moveX != 0 || moveY != 0) {
    Mouse.move(moveX, moveY, 0);
  }

  // ----------------------------------------------------
  // 2. JOYSTICK BUTTON -> MOUSE LEFT CLICK
  // ----------------------------------------------------
  bool currentJoyBtn = digitalRead(PIN_JOY_SW);
  if (currentJoyBtn == LOW && lastJoyBtn == HIGH) {
    Mouse.press(MOUSE_LEFT);
  } else if (currentJoyBtn == HIGH && lastJoyBtn == LOW) {
    Mouse.release(MOUSE_LEFT);
  }
  lastJoyBtn = currentJoyBtn;

  // ----------------------------------------------------
  // 3. TACTILE BUTTONS -> CUSTOM KEY SHORTCUTS
  // ----------------------------------------------------
  
  // SW1: Ctrl + Z (Undo)
  bool currentBtn1 = digitalRead(PIN_BTN1);
  if (currentBtn1 == LOW && lastBtn1 == HIGH) {
    Keyboard.press(KEY_LEFT_CTRL);
    Keyboard.press('z');
    delay(10);
    Keyboard.releaseAll();
  }
  lastBtn1 = currentBtn1;

  // SW2: Ctrl + C (Copy)
  bool currentBtn2 = digitalRead(PIN_BTN2);
  if (currentBtn2 == LOW && lastBtn2 == HIGH) {
    Keyboard.press(KEY_LEFT_CTRL);
    Keyboard.press('c');
    delay(10);
    Keyboard.releaseAll();
  }
  lastBtn2 = currentBtn2;

  // SW3: Ctrl + V (Paste)
  bool currentBtn3 = digitalRead(PIN_BTN3);
  if (currentBtn3 == LOW && lastBtn3 == HIGH) {
    Keyboard.press(KEY_LEFT_CTRL);
    Keyboard.press('v');
    delay(10);
    Keyboard.releaseAll();
  }
  lastBtn3 = currentBtn3;

  // SW4: Spacebar (Play / Pause / Action)
  bool currentBtn4 = digitalRead(PIN_BTN4);
  if (currentBtn4 == LOW && lastBtn4 == HIGH) {
    Keyboard.press(' ');
  } else if (currentBtn4 == HIGH && lastBtn4 == LOW) {
    Keyboard.release(' ');
  }
  lastBtn4 = currentBtn4;

  delay(10); // Loop polling rate (~100 Hz)
}
